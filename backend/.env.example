# WARAZ Backend Environment Configuration

# ---------------------------------------------------------------------------
# Database / Supabase Configuration
# ---------------------------------------------------------------------------
# To connect to Supabase PostgreSQL in production / serverless:
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For connection pooling (recommended for serverless): port 6543
DATABASE_URL=

# Supabase API (optional for direct Supabase SDK / Auth / Storage integration)
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
